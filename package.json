{
  "name": "agentpay-firewall",
  "version": "0.1.0",
  "private": true,
  "description": "On-chain policy vault that limits how much AI agents can spend (per-tx cap, daily budget, allowlist, freeze).",
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "typecheck": "tsc --noEmit",
    "coverage": "hardhat coverage",
    "gas": "cross-env REPORT_GAS=true hardhat test",
    "clean": "rimraf artifacts cache typechain-types dist coverage coverage.json",
    "node:local": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "demo:before": "hardhat run scripts/demo-before.ts --network localhost",
    "demo:after": "hardhat run scripts/demo-after.ts --network localhost",
    "demo:all": "node scripts/run-demo-all.js",
    "demo:reset": "hardhat run scripts/deploy.ts --network localhost",
    "agent:demo": "ts-node agent/agent.ts",
    "record:demo": "hardhat run scripts/record-demo.ts --network localhost",
    "ui": "serve frontend -l 5173"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "chai": "^4.5.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.8",
    "ethers": "^6.17.0",
    "hardhat": "^2.29.1",
    "picocolors": "^1.1.1",
    "rimraf": "^6.1.3",
    "serve": "^14.2.6",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
